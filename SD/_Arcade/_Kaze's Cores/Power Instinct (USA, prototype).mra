    <!-- INPUT_PORTS_START(powerinj) nmk16.cpp:3467-3474 (GAME() :10766): powerins with
         DSW2 bit 0 "Unknown" (default Off).  ids are listed by the RAW value of
         the bits, LSB = first bit.  default FF,FB: Demo Sounds On is DSW2 bit 2
         CLEAR.  Prototype: the program differs, the rest is the parent's. -->
    <switches default="FF,FB" base="0">
        <dip name="Free Play"      bits="0"       ids="On,Off"/>
        <dip name="Coin B"         bits="1,2,3"   ids="2C/1C (1 to cont),1C/4C,3C/1C,1C/2C,4C/1C,1C/3C,2C/1C,1C/1C"/>
        <dip name="Coin A"         bits="4,5,6"   ids="2C/1C (1 to cont),1C/4C,3C/1C,1C/2C,4C/1C,1C/3C,2C/1C,1C/1C"/>
        <dip name="Flip Screen"    bits="7"       ids="On,Off"/>
        <dip name="Unknown"        bits="8"       ids="On,Off"/>
        <dip name="Join In Mode"   bits="9"       ids="On,Off"/>
        <dip name="Demo Sounds"    bits="10"      ids="On,Off"/>
        <dip name="Allow Continue" bits="11"      ids="Off,On"/>
        <dip name="Blood Color"    bits="12"      ids="Blue,Red"/>
        <dip name="Game Time"      bits="13"      ids="Short,Normal"/>
        <dip name="Difficulty"     bits="14,15"   ids="Hardest,Easy,Hard,Normal"/>
    </switches>

    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin,Pause"
