# --------------------------------------------------------------------------
# Power Instinct -- source list.  Add files here, never through the IDE.
# --------------------------------------------------------------------------

# ---- MiSTer wrapper -------------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE PowerIns.sv
set_global_assignment -name SDC_FILE PowerIns.sdc

# ---- PLL: 48 / 48 (-10417 ps) / 100 MHz, from projects/vsystem/super_slams --
set_global_assignment -name QIP_FILE rtl/pll.qip

# ---- search paths ---------------------------------------------------------
# pi_rommap.svh; fx68k's $readmemb("microrom.mem") bare filenames; and
# `include "sys/emu_ports.vh" resolving against platforms/mister.
set_global_assignment -name SEARCH_PATH ../../rtl
set_global_assignment -name SEARCH_PATH ../../../../../third_party/cpu/fx68k
set_global_assignment -name SEARCH_PATH ../../../../../platforms/mister

# ---- platform transport ---------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE ../../integration/pi_download.sv

